{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client", "@shopify/polaris-types", "@shopify/app-bridge-types"]
  },
  "include": [
    "env.d.ts",
    "app/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts"
  ]
}
